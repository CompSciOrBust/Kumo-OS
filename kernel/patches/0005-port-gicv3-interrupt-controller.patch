+                u64 mpidr;
+                __asm__ __volatile__("mrs %0, mpidr_el1" : "=r"(mpidr));
+                return m_gicr[mpidr & 0xFF];
+            }
         public:
-            constexpr KInterruptController() : m_gicd(nullptr), m_gicc(nullptr) { /* ... */ }
+            constexpr KInterruptController() : m_gicd(nullptr), m_gicr{} { /* ... */ }
 
