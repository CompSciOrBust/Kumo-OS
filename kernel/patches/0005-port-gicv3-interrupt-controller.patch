     void KInterruptController::Initialize(s32 core_id) {
-        /* Setup pointers to ARM mmio. */
-        m_gicd = GetPointer<volatile GicDistributor >(KMemoryLayout::GetDeviceVirtualAddress(KMemoryRegionType_InterruptDistributor));
-        m_gicc = GetPointer<volatile GicCpuInterface>(KMemoryLayout::GetDeviceVirtualAddress(KMemoryRegionType_InterruptCpuInterface));
+        /* Obtain virtual addresses for GICD and this core's GICR frame. */
+        const KVirtualAddress gicd_va = KMemoryLayout::GetDeviceVirtualAddress(KMemoryRegionType_InterruptDistributor);
+        const KVirtualAddress gicr_va = KMemoryLayout::GetDeviceVirtualAddress(KMemoryRegionType_InterruptRedistributor);
+        m_gicd = GetPointer<volatile GicDistributor>(gicd_va);
+        /* Each core has a 0x20000-byte GICR frame (RD_base at +0, SGI_base at +0x10000). */
+        m_gicr[core_id] = GetPointer<volatile GicRedistributor>(gicr_va + static_cast<size_t>(core_id) * 0x20000);
+        auto *const gicr = m_gicr[core_id];
+
+        /* Enable System Register Interface (SRE) on this CPU. */
+        IccWrite_SRE(7);  /* SRE | DFB | DIB */
+
+        /* Disable Group 1 interrupts while configuring. */
+        IccWrite_IGRPEN1(0);
 
-        /* Clear CTLRs. */
-        m_gicc->ctlr = 0;
+        /* On core 0 only: disable GICD and enable ARE_NS + Group1NS. */
         if (core_id == 0) {
             m_gicd->ctlr = 0;
+            __asm__ __volatile__("dsb sy" ::: "memory");
+            /* EnableGrp1NS (bit 1) | ARE_NS (bit 5). */
+            m_gicd->ctlr = (1u << 1) | (1u << 5);
+            __asm__ __volatile__("dsb sy" ::: "memory");
         }
 
-        m_gicc->pmr = 0;
-        m_gicc->bpr = 7;
+        /* Wake up the redistributor: clear ProcessorSleep and wait for ChildrenAsleep to clear. */
+        u32 waker = gicr->waker;
+        waker &= ~(1u << 1);
+        gicr->waker = waker;
+        while (gicr->waker & (1u << 2)) {
+            __asm__ __volatile__("yield" ::: "memory");
+        }
 
-        /* Setup all interrupt lines. */
+        /* Setup interrupt lines. */
         SetupInterruptLines(core_id);
 
-        /* Set CTLRs. */
-        if (core_id == 0) {
-            m_gicd->ctlr = 1;
-        }
-        m_gicc->ctlr = 1;
-
-        /* Set the mask for this core. */
+        /* Store this core's affinity (MPIDR Aff0) for SGI routing. */
         SetGicMask(core_id);
 
-        /* Set the priority level. */
+        /* Set priority mask and binary point. */
+        IccWrite_BPR0(7);
+        IccWrite_CTLR(0);
         SetPriorityLevel(PriorityLevel_Low);
+
+        /* Enable Group 1 Non-Secure interrupts. */
+        IccWrite_IGRPEN1(1);
     }
 
