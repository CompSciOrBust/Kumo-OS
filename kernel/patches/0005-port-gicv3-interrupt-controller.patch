From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: CompSciOrBust <54033033+CompSciOrBust@users.noreply.github.com>
Date: Mon, 10 Nov 2026 00:00:00 +0000
Subject: [PATCH] gic: replace GICv2 CPU interface with GICv3 redistributor

Replace the MMIO-mapped GicCpuInterface struct with a GicRedistributor
covering both RD_base (0x0000) and SGI_base (+0x10000) frames.  All CPU
interface accesses are rewritten to use ICC system-register accessors
(IccWrite_SRE/PMR/IGRPEN1/etc.).  GICD_IROUTER replaces GICD_ITARGETSR
for SPI routing, and SetGicMask now reads MPIDR_EL1 directly.

---
diff --git a/libraries/libmesosphere/include/mesosphere/arch/arm/kern_generic_interrupt_controller.hpp b/libraries/libmesosphere/include/mesosphere/arch/arm/kern_generic_interrupt_controller.hpp
index a44c92218..c16cc1b2c 100644
--- a/libraries/libmesosphere/include/mesosphere/arch/arm/kern_generic_interrupt_controller.hpp
+++ b/libraries/libmesosphere/include/mesosphere/arch/arm/kern_generic_interrupt_controller.hpp
@@ -75,31 +75,78 @@ namespace ams::kern::arch::arm {
     static_assert(util::is_pod<GicDistributor>::value);
     static_assert(sizeof(GicDistributor) == 0x1000);
 
-    struct GicCpuInterface {
-        u32 ctlr;
-        u32 pmr;
-        u32 bpr;
-        u32 iar;
-        u32 eoir;
-        u32 rpr;
-        u32 hppir;
-        u32 abpr;
-        u32 aiar;
-        u32 aeoir;
-        u32 ahppir;
-        u32 statusr;
-        u32 reserved_30[4];
-        u32 impldef_40[36];
-        u32 apr[4];
-        u32 nsapr[4];
-        u32 reserved_f0[3];
-        u32 iidr;
-        u32 reserved_100[960];
-        u32 dir;
-        u32 _0x1004[1023];
+    /* GICv3 Redistributor - RD_base frame (0x0000) + SGI_base frame (+0x10000). */
+    struct GicRedistributor {
+        /* RD_base frame */
+        u32 ctlr;                           /* 0x0000 */
+        u32 iidr;                           /* 0x0004 */
+        u64 typer;                          /* 0x0008 */
+        u32 statusr;                        /* 0x0010 */
+        u32 waker;                          /* 0x0014 */
+        /* Pad from 0x0018 to 0x10000 (SGI_base frame start). */
+        u32 _pad_to_sgi[(0x10000 - 0x0018) / 4];
+        /* SGI_base frame */
+        u32 _sgi_pad0[0x80 / 4];            /* 0x10000-0x1007F */
+        u32 igroupr0;                        /* 0x10080 */
+        u32 _sgi_pad1[31];                   /* 0x10084-0x100FF */
+        u32 isenabler0;                      /* 0x10100 */
+        u32 _sgi_pad2[31];                   /* 0x10104-0x1017F */
+        u32 icenabler0;                      /* 0x10180 */
+        u32 _sgi_pad3[31];                   /* 0x10184-0x101FF */
+        u32 ispendr0;                        /* 0x10200 */
+        u32 _sgi_pad4[31];                   /* 0x10204-0x1027F */
+        u32 icpendr0;                        /* 0x10280 */
+        u32 _sgi_pad5[31];                   /* 0x10284-0x102FF */
+        u32 isactiver0;                      /* 0x10300 */
+        u32 _sgi_pad6[31];                   /* 0x10304-0x1037F */
+        u32 icactiver0;                      /* 0x10380 */
+        u32 _sgi_pad7[31];                   /* 0x10384-0x103FF */
+        union {
+            u8  bytes[32];
+            u32 words[8];
+        } ipriorityr;                        /* 0x10400-0x1041F */
+        u32 _sgi_pad8[0x7E0 / 4];            /* 0x10420-0x10BFF */
+        u32 icfgr[2];                        /* 0x10C00-0x10C07 */
+        u32 _sgi_pad9[0xF8 / 4];             /* 0x10C08-0x10CFF */
+        u32 igrpmodr0;                       /* 0x10D00 */
     };
-    static_assert(util::is_pod<GicCpuInterface>::value);
-    static_assert(sizeof(GicCpuInterface) == 0x2000);
+    static_assert(util::is_pod<GicRedistributor>::value);
+    static_assert(offsetof(GicRedistributor, waker)      == 0x0014);
+    static_assert(offsetof(GicRedistributor, igroupr0)   == 0x10080);
+    static_assert(offsetof(GicRedistributor, isenabler0) == 0x10100);
+    static_assert(offsetof(GicRedistributor, icenabler0) == 0x10180);
+    static_assert(offsetof(GicRedistributor, icpendr0)   == 0x10280);
+    static_assert(offsetof(GicRedistributor, ipriorityr) == 0x10400);
+    static_assert(offsetof(GicRedistributor, icfgr)      == 0x10C00);
+    static_assert(offsetof(GicRedistributor, igrpmodr0)  == 0x10D00);
+
+    /* ICC system register accessors (GICv3 CPU interface via MSR/MRS). */
+    static ALWAYS_INLINE void IccWrite_SRE(u64 val) {
+        __asm__ __volatile__("msr S3_0_C12_C12_5, %0\nisb" :: "r"(val) : "memory");
+    }
+    static ALWAYS_INLINE void IccWrite_PMR(u64 val) {
+        __asm__ __volatile__("msr S3_0_C4_C6_0, %0" :: "r"(val) : "memory");
+    }
+    static ALWAYS_INLINE void IccWrite_BPR0(u64 val) {
+        __asm__ __volatile__("msr S3_0_C12_C8_3, %0" :: "r"(val) : "memory");
+    }
+    static ALWAYS_INLINE void IccWrite_CTLR(u64 val) {
+        __asm__ __volatile__("msr S3_0_C12_C12_4, %0" :: "r"(val) : "memory");
+    }
+    static ALWAYS_INLINE void IccWrite_IGRPEN1(u64 val) {
+        __asm__ __volatile__("msr S3_0_C12_C12_7, %0\nisb" :: "r"(val) : "memory");
+    }
+    static ALWAYS_INLINE void IccWrite_EOIR1(u64 val) {
+        __asm__ __volatile__("msr S3_0_C12_C12_1, %0" :: "r"(val) : "memory");
+    }
+    static ALWAYS_INLINE u64 IccRead_IAR1() {
+        u64 val;
+        __asm__ __volatile__("mrs %0, S3_0_C12_C12_0" : "=r"(val) :: "memory");
+        return val;
+    }
+    static ALWAYS_INLINE void IccWrite_SGI1R(u64 val) {
+        __asm__ __volatile__("msr S3_0_C12_C11_5, %0\nisb" :: "r"(val) : "memory");
+    }
 
     struct KInterruptController {
         NON_COPYABLE(KInterruptController);
@@ -135,12 +182,20 @@ namespace ams::kern::arch::arm {
                 PriorityLevel_Scheduler = 2,
             };
         private:
+            /* Stores MPIDR Aff0 value for each core (used for GICD_IROUTER and ICC_SGI1R). */
             static constinit inline u32 s_mask[cpu::NumCores];
         private:
-            volatile GicDistributor  *m_gicd;
-            volatile GicCpuInterface *m_gicc;
+            volatile GicDistributor   *m_gicd;
+            volatile GicRedistributor *m_gicr[cpu::NumCores];
