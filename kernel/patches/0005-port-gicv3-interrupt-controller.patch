     void KInterruptController::SetupInterruptLines(s32 core_id) const {
-        const size_t ITLines = (core_id == 0) ? 32 * ((m_gicd->typer & 0x1F) + 1) : NumLocalInterrupts;
+        auto *const gicr = m_gicr[core_id];
