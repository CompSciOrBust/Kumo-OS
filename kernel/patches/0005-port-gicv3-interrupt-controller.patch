+            for (size_t i = 0; i < spi_words; ++i) {
+                m_gicd->icenabler[spi_start_word + i] = 0xFFFFFFFF;
+                m_gicd->icpendr  [spi_start_word + i] = 0xFFFFFFFF;
+                m_gicd->icactiver[spi_start_word + i] = 0xFFFFFFFF;
+                m_gicd->igroupr  [spi_start_word + i] = 0xFFFFFFFF;
+                m_gicd->igrpmodr [spi_start_word + i] = 0x00000000;
+            }
+            for (size_t i = NumLocalInterrupts; i < ITLines; ++i) {
