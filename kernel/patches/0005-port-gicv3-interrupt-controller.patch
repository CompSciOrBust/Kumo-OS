-                cfg &= ~(0x3 << (2 * (irq % (BITSIZEOF(u32) / 2))));
-                cfg |=  (0x0 << (2 * (irq % (BITSIZEOF(u32) / 2))));
-                m_gicd->icfgr[irq / (BITSIZEOF(u32) / 2)] = cfg;
+                if (IsLocal(irq)) {
+                    u32 cfg = GetCurrentGicr()->icfgr[irq / (BITSIZEOF(u32) / 2)];
+                    cfg &= ~(0x3u << (2 * (irq % (BITSIZEOF(u32) / 2))));
+                    GetCurrentGicr()->icfgr[irq / (BITSIZEOF(u32) / 2)] = cfg;
+                } else {
