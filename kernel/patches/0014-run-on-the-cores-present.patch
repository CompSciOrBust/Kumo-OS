diff --git a/libraries/libmesosphere/source/svc/kern_svc_processor.cpp b/libraries/libmesosphere/source/svc/kern_svc_processor.cpp
index 55d850c..481b9eb 100644
--- a/libraries/libmesosphere/source/svc/kern_svc_processor.cpp
+++ b/libraries/libmesosphere/source/svc/kern_svc_processor.cpp
@@ -22,6 +22,25 @@ namespace ams::kern::svc {
     namespace {
 
         int32_t GetCurrentProcessorNumber() {
+            #if defined(ATMOSPHERE_BOARD_GENERIC_AARCH64)
+            /* On this board several virtual cores can share one physical core (kern_cpu_map.hpp), so */
+            /* the physical core number is not an answer by itself. Return the lowest virtual core in */
+            /* the thread's affinity mask that maps to the core it is running on. With four cores the */
+            /* map is the identity and this gives the same answers as the code below. If the thread */
+            /* migrated while we looked, look again. */
+            while (true) {
+                const s32 current_phys_core = GetCurrentCoreId();
+                u64 v_affinity_mask = GetCurrentThread().GetVirtualAffinityMask();
+                while (v_affinity_mask != 0) {
+                    const s32 next_virt_core = static_cast<s32>(__builtin_ctzll(v_affinity_mask));
+                    if (current_phys_core == cpu::VirtualToPhysicalCoreMap[next_virt_core]) {
+                        return next_virt_core;
+                    }
+
+                    v_affinity_mask &= ~(1ul << next_virt_core);
+                }
+            }
+            #else
             /* Setup variables to track affinity information. */
             s32 current_phys_core;
             u64 v_affinity_mask   = 0;
@@ -47,6 +66,7 @@ namespace ams::kern::svc {
                     v_affinity_mask &= ~(1ul << next_virt_core);
                 } while (v_affinity_mask != 0);
             }
+            #endif
         }
 
     }
diff --git a/mesosphere/kernel/source/arch/arm64/init/kern_init_core.cpp b/mesosphere/kernel/source/arch/arm64/init/kern_init_core.cpp
index e37780b..d1a3fb3 100644
--- a/mesosphere/kernel/source/arch/arm64/init/kern_init_core.cpp
+++ b/mesosphere/kernel/source/arch/arm64/init/kern_init_core.cpp
@@ -61,6 +61,45 @@ namespace ams::kern::init {
 
         constexpr PageTableEntry KernelRwDataUncachedAttribute(PageTableEntry::Permission_KernelRW, PageTableEntry::PageAttribute_NormalMemoryNotCacheable, PageTableEntry::Shareable_InnerShareable, PageTableEntry::MappingFlag_Mapped);
 
+        #if defined(ATMOSPHERE_BOARD_GENERIC_AARCH64)
+        /* Set by core 0 once it has started every core it can and fixed the number present. */
+        /* The others wait for it in InvokeMain, before anything reads that number. */
+        constinit bool g_present_cores_known = false;
+
+        /* This board runs on however many cores the machine has, up to cpu::NumCores. */
+        void TurnOnAllCores() {
+            cpu::MultiprocessorAffinityRegisterAccessor mpidr;
+            const auto arg = mpidr.GetCpuOnArgument();
+            const auto current_core = mpidr.GetAff0();
+
+            /* Start cores 1, 2, ... in order, up to the number the firmware reports. Each target is */
+            /* the boot core's affinity with Aff0 replaced by the core's index, as on other boards. */
+            /* Cores must be numbered 0 to n - 1, so the first that fails to start ends the list: */
+            /* it and every later core are treated as absent. */
+            const s32 num_to_start = KSystemControl::Init::GetNumCoresToStart();
+            s32 num_present = 1;
+            for (s32 i = 0; i < num_to_start; i++) {
+                if (static_cast<s32>(current_core) != i) {
+                    if (!KSystemControl::Init::TryCpuOn(arg | i, g_init_arguments + i)) {
+                        break;
+                    }
+                    ++num_present;
+                }
+            }
+
+            /* Fix the number of cores and the userland core map, then let the started cores proceed. */
+            cpu::InitializePresentCores(num_present);
+            __atomic_store_n(std::addressof(g_present_cores_known), true, __ATOMIC_RELEASE);
+            cpu::DataSynchronizationBarrierInnerShareable();
+            __asm__ __volatile__("sev" ::: "memory");
+        }
+
+        void WaitForPresentCoresKnown() {
+            while (!__atomic_load_n(std::addressof(g_present_cores_known), __ATOMIC_ACQUIRE)) {
+                __asm__ __volatile__("wfe" ::: "memory");
+            }
+        }
+        #else
         void TurnOnAllCores() {
             cpu::MultiprocessorAffinityRegisterAccessor mpidr;
             const auto arg = mpidr.GetCpuOnArgument();
@@ -72,8 +111,14 @@ namespace ams::kern::init {
                 }
             }
         }
+        #endif
 
         void InvokeMain(u64 core_id) {
+            #if defined(ATMOSPHERE_BOARD_GENERIC_AARCH64)
+            /* Do not start until core 0 knows how many cores there are. */
+            WaitForPresentCoresKnown();
+            #endif
+
             /* Clear cpacr_el1. */
             cpu::SetCpacrEl1(0);
             cpu::InstructionMemoryBarrier();
