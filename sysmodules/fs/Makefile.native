# Independent devkitPro/libnx build for the fs system module.
DEVKITPRO ?= /opt/devkitpro
export DEVKITPRO
TOOLCHAIN := $(DEVKITPRO)/devkitA64/bin/aarch64-none-elf-
CC := $(TOOLCHAIN)gcc
CXX := $(TOOLCHAIN)g++
ELF2KIP := $(DEVKITPRO)/tools/bin/elf2kip
VARIANT ?= release
BUILD := build/native/$(VARIANT)
OUT := out/nintendo_nx_arm64_armv8a/$(VARIANT)
TARGET := $(OUT)/fs

SOURCES := $(shell find source ../common/source/ipc ../common/source/fs ../common/source/pci ../common/source/platform -type f \( -name '*.cpp' -o -name '*.c' \) | sort)
OBJECTS := $(foreach src,$(SOURCES),$(BUILD)/$(subst ../common/,common/,$(src)).o)
INCLUDES := -Isource -Isource/fat -I../../vendor/fatfs/source -I../common/include -I$(DEVKITPRO)/libnx/include
OPTIMIZATION := $(if $(filter release,$(VARIANT)),-O2,-Os)
COMMON_FLAGS := -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft $(OPTIMIZATION) -g \
    -Wall -Wextra -Werror -Wno-missing-field-initializers -fPIE -ffunction-sections -fdata-sections \
    -fno-strict-aliasing -fwrapv -D__SWITCH__ -D_GNU_SOURCE $(INCLUDES)
CXXFLAGS := $(COMMON_FLAGS) -std=gnu++23 -fno-rtti
CFLAGS := $(COMMON_FLAGS) -std=gnu11
LDFLAGS := -specs=$(DEVKITPRO)/libnx/switch.specs -fPIE -march=armv8-a+crc+crypto -mtune=cortex-a57 \
    -mtp=soft -Wl,-Map,$(TARGET).map -Wl,-z,relro,-z,now

.PHONY: all clean
all: $(TARGET).kip

$(TARGET).kip: $(TARGET).elf fs.json
	$(ELF2KIP) $< fs.json $@

$(TARGET).elf: $(OBJECTS)
	@mkdir -p $(OUT)
	$(CXX) $(LDFLAGS) $(OBJECTS) -L$(DEVKITPRO)/libnx/lib -lnx -o $@

define compile_source
$(BUILD)/$(subst ../common/,common/,$(1)).o: $(1)
	@mkdir -p $$(dir $$@)
	$(if $(filter %.cpp,$(1)),$(CXX) $(CXXFLAGS),$(CC) $(CFLAGS)) -MMD -MP -c $$< -o $$@
endef
$(foreach src,$(SOURCES),$(eval $(call compile_source,$(src))))

-include $(OBJECTS:.o=.d)
clean:
	rm -rf $(BUILD) $(OUT)
